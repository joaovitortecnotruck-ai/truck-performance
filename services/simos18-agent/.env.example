# Directory on this machine holding the .btp patch library (SwitchPatch, HSL,
# CBRICK, etc.). Never commit the real patches themselves to git.
PATCHES_DIR=C:\Users\Avell\Downloads\BinToolz-main\BinToolz-main\patches

# Shared secret the platform (or anyone else) must send as
# `Authorization: Bearer <API_KEY>` on every request. Generate a long random
# value for production - this service writes/patches ECU files, it must not
# be reachable without it.
API_KEY=change-me

# Optional: restrict which origins may call this from a browser directly.
# Leave empty if this is only ever called server-to-server.
CORS_ORIGINS=
