# Shared secret the platform (or anyone else) must send as
# `Authorization: Bearer <API_KEY>` on every request. Generate a long random
# value for production.
API_KEY=change-me

# Optional: restrict which origins may call this from a browser directly.
# Leave empty if this is only ever called server-to-server.
CORS_ORIGINS=

# How many bytes apart two differing bytes can be and still get merged into
# the same patch block (avoids one block per byte on scattered table edits).
MERGE_GAP=8

# Needed only for `agent.py analyze` / POST /analyze (the AI hypothesis
# layer). Leave empty to use diff/check/apply/revert without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
